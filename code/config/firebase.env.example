# Copy this file to ~/.config/rail_robot/firebase.env on the Jetson.
# Never commit the completed file. Protect it with: chmod 600 <file>
RAIL_ROBOT_FIREBASE_UPLOAD=1
RAIL_ROBOT_FIREBASE_API_KEY=PASTE_FIREBASE_WEB_API_KEY
RAIL_ROBOT_FIREBASE_UID=PASTE_DEDICATED_JETSON_AUTH_UID
RAIL_ROBOT_FIREBASE_EMAIL=PASTE_DEDICATED_JETSON_AUTH_EMAIL
RAIL_ROBOT_FIREBASE_PASSWORD=PASTE_DEDICATED_JETSON_AUTH_PASSWORD
RAIL_ROBOT_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT
RAIL_ROBOT_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_PROJECT.firebasestorage.app
RAIL_ROBOT_FIREBASE_TIMEOUT_SECONDS=30
