  <version>0.1.0</version>
  <description>Typed camera, inspection and STM interfaces for rail_robot.</description>
  <maintainer email="maintainers@example.invalid">Rail robot maintainers</maintainer>
  <license>LicenseRef-Project</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
