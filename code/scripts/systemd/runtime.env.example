# Copy to ~/.config/rail_robot/runtime.env on the Jetson.
# systemd EnvironmentFile format: KEY=value, no shell expansion.
# rail-mission.service and rail-webrtc.service both read this file, so the
# ROS domain can never differ between the mission stack and the video sender.
ROS_DOMAIN_ID=77
NVIDIA_TF32_OVERRIDE=0
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_PROJECT.firebasestorage.app
# Crane shown in the dashboard crane selector (defaults: CRANE-01 / 1번 크레인).
RAIL_ROBOT_CRANE_ID=CRANE-01
RAIL_ROBOT_CRANE_LABEL=1번 크레인
