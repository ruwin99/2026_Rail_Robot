# Firebase console > Project settings > Your apps > Web app configuration
VITE_FIREBASE_API_KEY=replace-with-your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-your-sender-id
VITE_FIREBASE_APP_ID=replace-with-your-app-id
